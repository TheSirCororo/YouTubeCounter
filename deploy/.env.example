# Template for the deployment host's .env file. Copy to .env NEXT TO
# docker-compose.yml on the server, fill in the real values, then:
#
#     chmod 600 .env
#
# The real .env must never be committed - .gitignore covers it, but this is a
# public repository, so double-check `git status` before every commit.

# --- Secrets -----------------------------------------------------------------
# From the Google Cloud console, APIs & Services -> Credentials, on the same
# OAuth client whose ID is compiled into the desktop app (GoogleOAuthApi.kt).
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# --- Deployment settings -----------------------------------------------------
# Host port the reverse proxy forwards to. Bound to 127.0.0.1 by the compose
# file; the container always listens on 8080 internally, so leave SERVER_PORT unset.
HOST_PORT=8080

# Image to run. On the server these are environment variables of the service, not
# a file. CI always ships `latest`; pin APP_TAG to a specific `sha-<short>` to roll
# back, and put it back to `latest` afterwards.
APP_IMAGE=ghcr.io/thesircororo/youtubecounter-backend
APP_TAG=latest
